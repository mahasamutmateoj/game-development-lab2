[gd_scene load_steps=6 format=3]

[ext_resource type="Script" path="res://hud.gd" id="1"]
[ext_resource type="FontFile" path="res://assets/fonts/Xolonium-Regular.ttf" id="2"]
[ext_resource type="FontFile" path="res://assets/fonts/student.ttf" id="3"]

[sub_resource type="InputEventAction" id="InputEventAction_start"]
action = &"start_game"

[sub_resource type="Shortcut" id="Shortcut_start"]
events = Array[InputEvent]([SubResource("InputEventAction_start")])

[node name="HUD" type="CanvasLayer"]
script = ExtResource("1")

[node name="ScoreLabel" type="Label" parent="."]
offset_left = 0.0
offset_top = 10.0
offset_right = 480.0
offset_bottom = 100.0
mouse_filter = 2
theme_override_fonts/font = ExtResource("2")
theme_override_font_sizes/font_size = 64
text = "0"
horizontal_alignment = 1
vertical_alignment = 1

[node name="Message" type="Label" parent="."]
offset_left = 0.0
offset_top = 240.0
offset_right = 480.0
offset_bottom = 460.0
mouse_filter = 2
theme_override_fonts/font = ExtResource("2")
theme_override_font_sizes/font_size = 64
text = "Dodge the Creeps!"
horizontal_alignment = 1
vertical_alignment = 1
autowrap_mode = 2

[node name="StartButton" type="Button" parent="."]
offset_left = 140.0
offset_top = 580.0
offset_right = 340.0
offset_bottom = 680.0
theme_override_fonts/font = ExtResource("2")
theme_override_font_sizes/font_size = 64
text = "Start"
shortcut = SubResource("Shortcut_start")

[node name="MessageTimer" type="Timer" parent="."]
wait_time = 2.0
one_shot = true

[node name="StudentName" type="Label" parent="."]
offset_left = 4.0
offset_top = 684.0
offset_right = 476.0
offset_bottom = 717.0
mouse_filter = 2
theme_override_fonts/font = ExtResource("3")
theme_override_font_sizes/font_size = 14
text = "มหาสมุทร แมทิโอ เจแคน  |  673380339-5"
horizontal_alignment = 1
vertical_alignment = 1

[connection signal="pressed" from="StartButton" to="." method="_on_start_button_pressed"]
[connection signal="timeout" from="MessageTimer" to="." method="_on_message_timer_timeout"]
